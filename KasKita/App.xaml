<Application x:Class="KasKita.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:KasKita.ViewModels"
             xmlns:views="clr-namespace:KasKita.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="B2V" />
            <views:InverseBoolToVisibilityConverter x:Key="InvB2V" />

            <!-- ViewModel -> View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TransaksiViewModel}"><views:TransaksiView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:IuranViewModel}"><views:IuranView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AnggaranViewModel}"><views:AnggaranView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LaporanViewModel}"><views:LaporanView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MasterViewModel}"><views:MasterView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
