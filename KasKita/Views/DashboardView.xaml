<UserControl x:Class="KasKita.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Style="{StaticResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                <ComboBox Grid.Column="1" Width="190" ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Rentang grafik" />
            </Grid>

            <!-- kartu ringkasan -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" Style="{StaticResource HoverCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Wallet" Margin="0,0,6,0" />
                            <TextBlock Text="Saldo kas saat ini" Style="{StaticResource CardCaption}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Saldo, StringFormat='Rp {0:N0}', ConverterCulture=id-ID}" Style="{StaticResource CardValue}" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="1" Style="{StaticResource HoverCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" Margin="0,0,6,0" Foreground="SeaGreen" />
                            <TextBlock Text="Pemasukan (rentang)" Style="{StaticResource CardCaption}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalMasuk, StringFormat='Rp {0:N0}', ConverterCulture=id-ID}" Style="{StaticResource CardValue}" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" Style="{StaticResource HoverCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingDown" Margin="0,0,6,0" Foreground="IndianRed" />
                            <TextBlock Text="Pengeluaran (rentang)" Style="{StaticResource CardCaption}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalKeluar, StringFormat='Rp {0:N0}', ConverterCulture=id-ID}" Style="{StaticResource CardValue}" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="3" Style="{StaticResource HoverCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Margin="0,0,6,0" Foreground="DarkOrange" />
                            <TextBlock Text="Tunggakan iuran" Style="{StaticResource CardCaption}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardValue}">
                            <Run Text="{Binding JumlahTunggakan, Mode=OneWay}" /><Run Text=" tagihan" FontSize="13" />
                        </TextBlock>
                        <TextBlock Text="{Binding TotalTunggakan, StringFormat='Rp {0:N0}', ConverterCulture=id-ID}" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- baris grafik 1 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" Style="{StaticResource HoverCard}">
                    <StackPanel>
                        <TextBlock Text="Tren saldo kas" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <lvc:CartesianChart Height="260" Series="{Binding TrenSeries}" XAxes="{Binding TrenX}" YAxes="{Binding TrenY}"
                                            LegendPosition="Hidden" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="1" Style="{StaticResource HoverCard}">
                    <StackPanel>
                        <TextBlock Text="Komposisi pengeluaran" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <lvc:PieChart Height="260" Series="{Binding KomposisiSeries}" LegendPosition="Bottom"
                                      LegendTextPaint="{Binding LegendPaint}" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- baris grafik 2 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" Style="{StaticResource HoverCard}">
                    <StackPanel>
                        <TextBlock Text="Pemasukan vs pengeluaran per bulan" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <lvc:CartesianChart Height="260" Series="{Binding BarSeries}" XAxes="{Binding BarX}" YAxes="{Binding BarY}"
                                            LegendPosition="Bottom" LegendTextPaint="{Binding LegendPaint}" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="1" Style="{StaticResource HoverCard}">
                    <StackPanel>
                        <TextBlock Text="Notifikasi" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Tidak ada peringatan." Opacity="0.6" Margin="0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Notifikasis.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Notifikasis}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <materialDesign:PackIcon Kind="{Binding Ikon}" Width="20" Height="20" Margin="0,2,8,0"
                                                                 Foreground="DarkOrange" />
                                        <TextBlock Text="{Binding Pesan}" TextWrapping="Wrap" MaxWidth="280" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
