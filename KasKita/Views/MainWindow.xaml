<Window x:Class="KasKita.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:KasKita.Services"
        Title="KasKita - Manajemen Keuangan Organisasi" Width="1320" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <materialDesign:DialogHost Identifier="Root" CloseOnClickAway="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- UI-07: navigasi samping yang dapat diciutkan -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="0" materialDesign:ElevationAssist.Elevation="Dp4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,12">
                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ToggleMenuCommand}"
                                ToolTip="Ciutkan / perluas menu">
                            <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" />
                        </Button>
                        <TextBlock Text="KasKita" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,16,0"
                                   Visibility="{Binding MenuExpanded, Converter={StaticResource B2V}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,12">
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,8"
                                    Visibility="{Binding MenuExpanded, Converter={StaticResource B2V}}">
                            <materialDesign:PackIcon Kind="Account" Width="28" Height="28" VerticalAlignment="Center" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding NamaUser}" FontWeight="SemiBold" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding RoleText}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <!-- UI-03: tema terang / gelap -->
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                            <materialDesign:PackIcon Kind="ThemeLightDark" Width="24" Height="24" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" Margin="12,0,0,0"
                                          IsChecked="{Binding IsDark}" ToolTip="Tema gelap (Ctrl+D)" />
                        </StackPanel>

                        <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding LogoutCommand}"
                                HorizontalContentAlignment="Left" ToolTip="Keluar">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Logout" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="KELUAR" Margin="12,0,0,0"
                                           Visibility="{Binding DataContext.MenuExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,6" ToolTip="{Binding Judul}">
                                    <materialDesign:PackIcon Kind="{Binding Ikon}" Width="24" Height="24" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Judul}" Margin="14,0,24,0" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.MenuExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>

            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}" />
                <materialDesign:Snackbar MessageQueue="{x:Static svc:Toast.Queue}"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" />
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
